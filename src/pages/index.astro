---
// Auto-detect language from Accept-Language header, default to English
// Cloudflare Pages provides the header from the user's browser/IP settings
const lang = Astro.preferredLocale || Astro.preferredLocaleList?.[0] || 'en';
const redirect = lang.startsWith('zh') ? '/zh/' : '/en/';
---
<meta http-equiv="refresh" content={`0;url=${redirect}`} />
<script define:vars={{ redirect }}>
  window.location.replace(redirect);
</script>
