---
// Root = English default
import Base from '../layouts/Base.astro';
---
<Base title="Home" lang="en">
  <nav class="lang-switch">
    <a href="/" class="active">EN</a>
    <span>|</span>
    <a href="/zh/">中</a>
  </nav>

  <!-- ═══ Hero ═══ -->
  <section class="hero">
    <div class="hero-content">
      <h1 class="hero-title">🐱 CatCoding</h1>
      <p class="hero-tagline">Let AI cats collaborate like a dev team.<br/>Rust daemon + Python agents + Vue dashboard.</p>

      <div class="badge-row">
        <span class="badge rust">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          Rust Daemon
        </span>
        <span class="badge python">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a5 5 0 0 0-5 5v2h10V7a5 5 0 0 0-5-5z"/><rect x="3" y="9" width="18" height="13" rx="2"/></svg>
          Python Agents
        </span>
        <span class="badge vue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
          Vue 3 Dashboard
        </span>
      </div>

      <div class="cta-row">
        <a href="https://demo.catcoding.org" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Live Demo
        </a>
        <a href="https://github.com/zocs/catcoding" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          Star on GitHub
        </a>
        <a href="#quickstart" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Quick Start
        </a>
      </div>

    </div>
  </section>

  <!-- ═══ Features ═══ -->
  <section id="features">
    <div class="container">
      <p class="section-label">Features</p>
      <h2 class="section-title">Everything you need for multi-agent dev</h2>
      <p class="section-subtitle">Framework-agnostic orchestration with cat-themed agents, real-time monitoring, and pluggable adapters.</p>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Watchdog Guardian</h3>
          <p>Triple-detection: heartbeat timeout + compile check + API call tracking. Auto-recovery with context preservation.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </div>
          <h3>Visual Dashboard</h3>
          <p>Real-time Kanban, Gantt charts, agent status monitoring. Vue 3 + Naive UI with cat-themed agent avatars.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>Multi-Adapter</h3>
          <p>Pluggable adapters for Hermes, Claude Code, Codex, OpenClaw. Unified orchestration across AI CLI tools.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon purple">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>L4 Memory System</h3>
          <p>Four-layer memory: Index → Facts → Skills → Sessions. Auto-learning and skill crystallization from verified execution paths.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <h3>Cat Persona System</h3>
          <p>Each agent has a unique cat character — PM is Siamese, Dev is British Shorthair, Reviewer is Bombay. Making dev fun.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon orange">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3>NATS Message Bus</h3>
          <p>Rust daemon with NATS JetStream for agent communication. Persistent streams, pub/sub, and heartbeat channels.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Architecture ═══ -->
  <section id="architecture">
    <div class="container">
      <p class="section-label">Architecture</p>
      <h2 class="section-title">Rust core + Python agents + Vue frontend</h2>

      <div class="arch-diagram">┌──────────────────────────────────────────────────┐
│                     User Layer                    │
│          Dashboard (Vue 3)           CLI          │
└─────────────────────┬────────────────────────────┘
                      │
┌─────────────────────▼────────────────────────────┐
│            CatCoding Daemon (Rust)                │
│  ┌───────────┐  ┌───────────┐  ┌──────────────┐  │
│  │  Watchdog │  │ Scheduler │  │    Router    │  │
│  │  Triple   │  │ Dep-gated │  │   NATS Msg   │  │
│  └───────────┘  └───────────┘  └──────────────┘  │
│  ┌───────────────────────────────────────────┐   │
│  │              Adapter Layer                │   │
│  │    Hermes   │   Claude Code   │   Codex   │   │
│  └───────────────────────────────────────────┘   │
└─────────────────────┬────────────────────────────┘
                      │
┌─────────────────────▼────────────────────────────┐
│              Python Agent SDK                     │
│   PM (Siamese)  │  Dev (British)  │  Rev (Bombay) │
└──────────────────────────────────────────────────┘</div>
    </div>
  </section>

  <!-- ═══ Quick Start ═══ -->
  <section id="quickstart">
    <div class="container">
      <p class="section-label">Getting Started</p>
      <h2 class="section-title">Up and running in 3 steps</h2>
      <p class="section-subtitle">Install, initialize, and start your cat dev team.</p>

      <div class="quickstart-steps">
        <div class="code-block">
          <span class="comment"># 1. Install</span><br/>
          <span class="cmd">curl</span> <span class="flag">-fsSL</span> https://catcoding.org/install.sh | <span class="cmd">bash</span>
        </div>
        <div class="code-block">
          <span class="comment"># 2. Initialize project</span><br/>
          <span class="cmd">cd</span> your-project && <span class="cmd">catcoding</span> init
        </div>
        <div class="code-block">
          <span class="comment"># 3. Start daemon + dashboard</span><br/>
          <span class="cmd">catcoding</span> serve<br/>
          <span class="comment"># → Dashboard + API: http://127.0.0.1:19800</span>
        </div>
      </div>
    </div>
  </section>
</Base>
