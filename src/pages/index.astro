---
// Root = English default. Browser language detection via JS redirect.
import Base from '../layouts/Base.astro';
---
<Base title="Home" lang="en">
  <nav class="lang-switch">
    <a href="/" class="active">EN</a>
    <span>|</span>
    <a href="/zh/">中文</a>
  </nav>

  <section class="hero">
    <div class="hero-content">
      <h1>🐱 CatCoding</h1>
      <p class="tagline">Let AI cats collaborate like a dev team</p>
      <div class="badge-row">
        <span class="badge rust">🦀 Rust Daemon</span>
        <span class="badge python">🐍 Python Agents</span>
        <span class="badge vue">💚 Vue 3 Dashboard</span>
      </div>
      <div class="cta-row">
        <a href="https://demo.catcoding.org" class="btn btn-primary">🎮 Live Demo</a>
        <a href="https://github.com/zocs/catcoding" class="btn btn-secondary">⭐ Star on GitHub</a>
        <a href="#quickstart" class="btn btn-secondary">🚀 Quick Start</a>
      </div>
    </div>
  </section>

  <section id="features">
    <div class="container">
      <h2 class="section-title">✨ Features</h2>
      <p class="section-subtitle">A framework-agnostic multi-agent collaborative dev framework</p>
      <div class="features-grid">
        <div class="feature-card">
          <div class="icon">🐱</div>
          <h3>Cat Persona System</h3>
          <p>Each agent has a unique cat character — PM is Siamese, Dev is British Shorthair, Reviewer is Bombay</p>
        </div>
        <div class="feature-card">
          <div class="icon">🦉</div>
          <h3>Watchdog Guardian</h3>
          <p>Triple-detection: heartbeat timeout + compile check + API call tracking, with auto-recovery</p>
        </div>
        <div class="feature-card">
          <div class="icon">📋</div>
          <h3>Visual Dashboard</h3>
          <p>Real-time Kanban, Gantt charts, agent status monitoring, Bug Hunter animation</p>
        </div>
        <div class="feature-card">
          <div class="icon">🔄</div>
          <h3>Multi-Adapter</h3>
          <p>Pluggable adapters — Hermes, Claude Code, Codex, unified orchestration</p>
        </div>
        <div class="feature-card">
          <div class="icon">🧠</div>
          <h3>L4 Memory System</h3>
          <p>Four-layer memory: Index → Facts → Skills → Sessions, auto-learning and skill crystallization</p>
        </div>
        <div class="feature-card">
          <div class="icon">🐛</div>
          <h3>Bug = Mouse</h3>
          <p>Funny bug classification system — catching mice = fixing bugs, making dev fun</p>
        </div>
      </div>
    </div>
  </section>

  <section id="architecture">
    <div class="container">
      <h2 class="section-title">🏗️ Architecture</h2>
      <p class="section-subtitle">Rust high-performance core + Python flexible agents + Vue frontend</p>
      <div class="arch-diagram">┌──────────────────────────────────────────────────┐
│                     User Layer                    │
│          Dashboard (Vue 3)           CLI          │
└─────────────────────┬────────────────────────────┘
                      │
┌─────────────────────▼────────────────────────────┐
│            CatCoding Daemon (Rust)                │
│  ┌───────────┐  ┌───────────┐  ┌──────────────┐  │
│  │  Watchdog │  │ Scheduler │  │    Router    │  │
│  │  Triple   │  │ Dep-gated │  │   NATS Msg   │  │
│  └───────────┘  └───────────┘  └──────────────┘  │
│  ┌───────────────────────────────────────────┐   │
│  │              Adapter Layer                │   │
│  │    Hermes   │   Claude Code   │   Codex   │   │
│  └───────────────────────────────────────────┘   │
└─────────────────────┬────────────────────────────┘
                      │
┌─────────────────────▼────────────────────────────┐
│              Python Agent SDK                     │
│   PM (Siamese)  │  Dev (British)  │  Rev (Bombay) │
└──────────────────────────────────────────────────┘</div>
    </div>
  </section>

  <section id="quickstart">
    <div class="container">
      <h2 class="section-title">🚀 Quick Start</h2>
      <p class="section-subtitle">Get your cat dev team running in 3 steps</p>
      <div style="max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">
        <div class="code-block">
          <span class="comment"># 1. Install</span><br/>
          <span class="cmd">curl</span> <span class="flag">-fsSL</span> https://catcoding.org/install.sh | <span class="cmd">bash</span>
        </div>
        <div class="code-block">
          <span class="comment"># 2. Initialize project</span><br/>
          <span class="cmd">cd</span> your-project && <span class="cmd">catcoding</span> init
        </div>
        <div class="code-block">
          <span class="comment"># 3. Start daemon + dashboard</span><br/>
          <span class="cmd">catcoding</span> serve<br/>
          <span class="comment"># → Dashboard: http://localhost:8080</span><br/>
          <span class="comment"># → API: http://127.0.0.1:9527</span>
        </div>
      </div>
    </div>
  </section>
</Base>
