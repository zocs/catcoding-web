---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  path?: string;
}

const {
  title,
  description = 'Let AI cats collaborate like a dev team',
  lang = 'en',
  path = '/',
} = Astro.props;
const langDesc = lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : description;
const siteOrigin = 'https://catcoding.org';
const canonicalPath = path.startsWith('/') ? path : `/${path}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogImage = `${siteOrigin}/og-cover.svg`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={langDesc} />
  <title>{title} — CatCoding</title>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CatCoding" />
  <meta property="og:title" content={`${title} — CatCoding`} />
  <meta property="og:description" content={langDesc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} — CatCoding`} />
  <meta name="twitter:description" content={langDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={`${siteOrigin}/`} />
  <link rel="alternate" hreflang="zh-CN" href={`${siteOrigin}/zh/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark"></button>
  <slot />
  <script is:inline>
    (function() {
      const btn = document.getElementById('theme-toggle');
      const saved = localStorage.getItem('cc-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      btn.textContent = theme === 'dark' ? '☀️' : '🌙';
      btn.addEventListener('click', function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('cc-theme', next);
        btn.textContent = next === 'dark' ? '☀️' : '🌙';
      });

      // Disable decorative cat-hunt animation for automation runs (e.g. Lighthouse CI)
      // to keep performance benchmarks stable and avoid noisy regressions.
      if (!navigator.webdriver) {
        let catHuntLoaded = false;
        const loadCatHunt = function() {
          if (catHuntLoaded) return;
          catHuntLoaded = true;
          const script = document.createElement('script');
          script.src = '/cat-hunt.js';
          script.async = true;
          document.body.appendChild(script);
        };

        const onUserIntent = function() {
          loadCatHunt();
          window.removeEventListener('pointermove', onUserIntent);
          window.removeEventListener('touchstart', onUserIntent);
          window.removeEventListener('keydown', onUserIntent);
        };
        window.addEventListener('pointermove', onUserIntent, { once: true, passive: true });
        window.addEventListener('touchstart', onUserIntent, { once: true, passive: true });
        window.addEventListener('keydown', onUserIntent, { once: true });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadCatHunt, { timeout: 4000 });
        } else {
          setTimeout(loadCatHunt, 4000);
        }
      }
    })();
  </script>
  <footer>
    <div class="container">
      <p>CatCoding — {lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : 'Let AI cats collaborate like a dev team'}</p>
      <p style="margin-top: 12px;">
        <a href="https://github.com/zocs/catcoding">GitHub</a>
        &nbsp;·&nbsp;
        <a href="https://demo.catcoding.org">{lang === 'zh' ? '在线演示' : 'Live Demo'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/docs">{lang === 'zh' ? '文档' : 'Documentation'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/LICENSE">MIT License</a>
      </p>
    </div>
  </footer>
</body>
</html>
