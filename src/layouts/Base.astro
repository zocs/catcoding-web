---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  path?: string;
}

const {
  title,
  description = 'Let AI cats collaborate like a dev team',
  lang = 'en',
  path = '/',
} = Astro.props;
const langDesc = lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : description;
const siteOrigin = 'https://catcoding.org';
const canonicalPath = path.startsWith('/') ? path : `/${path}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogImage = `${siteOrigin}/favicon.svg`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={langDesc} />
  <title>{title} — CatCoding</title>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="CatCoding" />
  <meta property="og:title" content={`${title} — CatCoding`} />
  <meta property="og:description" content={langDesc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={`${title} — CatCoding`} />
  <meta name="twitter:description" content={langDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={`${siteOrigin}/`} />
  <link rel="alternate" hreflang="zh-CN" href={`${siteOrigin}/zh/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark"></button>
  <slot />
  <script src="/cat-hunt.js" is:inline></script>
  <script is:inline>
    (function() {
      const btn = document.getElementById('theme-toggle');
      const saved = localStorage.getItem('cc-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      btn.textContent = theme === 'dark' ? '☀️' : '🌙';
      btn.addEventListener('click', function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('cc-theme', next);
        btn.textContent = next === 'dark' ? '☀️' : '🌙';
      });
    })();
  </script>
  <footer>
    <div class="container">
      <p>CatCoding — {lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : 'Let AI cats collaborate like a dev team'}</p>
      <p style="margin-top: 12px;">
        <a href="https://github.com/zocs/catcoding">GitHub</a>
        &nbsp;·&nbsp;
        <a href="https://demo.catcoding.org">{lang === 'zh' ? '在线演示' : 'Live Demo'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/docs">{lang === 'zh' ? '文档' : 'Documentation'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/LICENSE">MIT License</a>
      </p>
    </div>
  </footer>
</body>
</html>
