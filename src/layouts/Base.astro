---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = 'Let AI cats collaborate like a dev team', lang = 'en' } = Astro.props;
const langDesc = lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : description;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={langDesc} />
  <title>{title} — CatCoding</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script src="/cat-hunt.js" is:inline></script>
  <footer>
    <div class="container">
      <p>CatCoding — {lang === 'zh' ? '让 AI 像猫咪团队一样协作写代码' : 'Let AI cats collaborate like a dev team'}</p>
      <p style="margin-top: 12px;">
        <a href="https://github.com/zocs/catcoding">GitHub</a>
        &nbsp;·&nbsp;
        <a href="https://demo.catcoding.org">{lang === 'zh' ? '在线演示' : 'Live Demo'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/docs">{lang === 'zh' ? '文档' : 'Documentation'}</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/zocs/catcoding/blob/main/LICENSE">MIT License</a>
      </p>
    </div>
  </footer>
</body>
</html>
